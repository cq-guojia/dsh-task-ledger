#!/bin/sh
# 台账命令入口：只按平台选对二进制再 exec，逻辑全在编译产物里。
set -eu

dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

case "$(uname -s)" in
	Linux) os=linux ;;
	Darwin) os=darwin ;;
	MINGW* | MSYS* | CYGWIN*) os=windows ;;
	*)
		echo "错误：这个平台（$(uname -s)）还没有配套的台账二进制。" >&2
		echo "  处理：在装有 Go 的机器上跑 packages/skill/src 的构建脚本，产出 scripts/bin/ledger-<os>-<arch>。" >&2
		exit 1
		;;
esac

case "$(uname -m)" in
	x86_64 | amd64) arch=amd64 ;;
	arm64 | aarch64) arch=arm64 ;;
	*)
		echo "错误：不认识的 CPU 架构（$(uname -m)），没有配套的台账二进制。" >&2
		exit 1
		;;
esac

bin="$dir/bin/ledger-$os-$arch"
if [ "$os" = "windows" ]; then
	bin="$bin.exe"
fi

if [ ! -x "$bin" ]; then
	# 打包 / 拷贝常常丢可执行位：自己救一次，救不回来再报错
	chmod +x "$bin" 2>/dev/null || true
fi

if [ ! -x "$bin" ]; then
	# 两种原因分开说：文件在但起不来（丢了可执行位 / noexec）与根本没有这个平台的产物
	if [ -f "$bin" ]; then
		echo "错误：$bin 存在但跑不起来（可执行位丢了，或所在分区不允许执行）" >&2
		echo "  处理：chmod +x \"$bin\" 后重跑；仍不行就把 skill 装到普通本地目录。" >&2
	else
		echo "错误：当前平台（$os/$arch）没有配套的台账二进制：$bin" >&2
		echo "  处理：在装有 Go 的机器上按 packages/skill/src 的源码交叉编译出 ledger-$os-$arch，放进 scripts/bin/。" >&2
		echo "  进度见 https://github.com/cq-guojia/dsh-task-ledger/issues" >&2
	fi
	exit 1
fi

exec "$bin" "$@"
