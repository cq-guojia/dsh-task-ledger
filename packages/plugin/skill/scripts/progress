#!/bin/sh
# 台账命令入口：只按平台选对二进制再 exec，逻辑全在编译产物里。
# 旧写法（Python 版已挪到 legacy-python/ 作对照）：python3 legacy-python/progress.py <子命令> --repo <工作区根>
set -eu

dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

case "$(uname -s)" in
	Linux) os=linux ;;
	Darwin) os=darwin ;;
	MINGW* | MSYS* | CYGWIN*) os=windows ;;
	*)
		echo "错误：这个平台（$(uname -s)）还没有配套的台账二进制。" >&2
		echo "  处理：在装有 Go 的机器上跑 packages/skill/go 的构建脚本，产出 scripts/bin/ledger-<os>-<arch>。" >&2
		exit 1
		;;
esac

case "$(uname -m)" in
	x86_64 | amd64) arch=amd64 ;;
	arm64 | aarch64) arch=arm64 ;;
	*)
		echo "错误：不认识的 CPU 架构（$(uname -m)），没有配套的台账二进制。" >&2
		exit 1
		;;
esac

bin="$dir/bin/ledger-$os-$arch"
if [ "$os" = "windows" ]; then
	bin="$bin.exe"
fi

if [ ! -x "$bin" ]; then
	# 打包 / 拷贝常常丢可执行位：自己救一次，救不回来再报错
	chmod +x "$bin" 2>/dev/null || true
fi

if [ ! -x "$bin" ]; then
	echo "错误：找不到可执行的 $bin" >&2
	echo "  处理：在装有 Go 的机器上跑 packages/skill/go 的构建脚本重新产出产物。" >&2
	exit 1
fi

exec "$bin" "$@"
